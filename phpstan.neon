includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    tmpDir: storage/framework/cache/phpstan

    # Read model casts from the array returned by casts() so casted attributes
    # (enums, dates, arrays) get their real types.
    parseModelCastsMethod: true
